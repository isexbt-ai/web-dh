{
    "name": "isexbt-ai/web-dh",
    "description": "美女导航站（Slim 4 重构版）",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0 <8.6",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^6.4",
        "matthiasmullie/minify": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "build": "php build.php",
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
