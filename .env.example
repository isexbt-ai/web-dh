# 站点域名（robots/sitemap/canonical 使用）
SITE_DOMAIN=dh.xlbk.blog

# Cloudflare R2（tools/auto_article.php / tools/migrate_r2.php 使用）
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# 调试开关（生产保持 false，开启会暴露异常详情）
APP_DEBUG=false

# ============================================================
# 说明：
# - 复制本文件为 .env 并填写（.env 不入 git）
# - 站点标题/描述/留言板/umami 等业务配置在后台「站点配置」页管理（存 site_config 表）
# - 首次登录后台前，先执行 php tools/create_admin.php <用户名> <密码> 创建管理员
# ============================================================
